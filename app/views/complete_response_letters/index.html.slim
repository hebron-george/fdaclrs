= form_with url: complete_response_letters_path, method: :get, data: { turbo_frame: "_top" } do |f|
  .flex.gap-6
    / — Filter sidebar —
    aside.w-72.flex-shrink-0
      .bg-white.rounded-lg.border.border-gray-200.p-5.space-y-5
        h2.text-sm.font-semibold.text-gray-700.uppercase.tracking-wide Filters

        / Full-text search
        div
          = f.label :q, "Search", class: "block text-sm font-medium text-gray-700 mb-1"
          = f.text_field :q, value: params[:q], placeholder: "Gene therapy, company name, BLA…",
              class: "w-full rounded-md border-gray-300 shadow-sm text-sm focus:border-blue-500 focus:ring-blue-500"

        / FDA Center
        div
          = f.label :center, "FDA Center", class: "block text-sm font-medium text-gray-700 mb-1"
          = f.select :center,
              options_for_select([["All Centers", ""]] + @centers.map { |c| [c, c] }, @selected_center),
              {},
              class: "w-full rounded-md border-gray-300 shadow-sm text-sm focus:border-blue-500 focus:ring-blue-500"

        / Company name
        div
          = f.label :company, "Company", class: "block text-sm font-medium text-gray-700 mb-1"
          = f.text_field :company, value: params[:company], placeholder: "Partial name…",
              class: "w-full rounded-md border-gray-300 shadow-sm text-sm focus:border-blue-500 focus:ring-blue-500"

        / Application number
        div
          = f.label :application_number, "Application Number", class: "block text-sm font-medium text-gray-700 mb-1"
          = f.text_field :application_number, value: params[:application_number], placeholder: "BLA 761373…",
              class: "w-full rounded-md border-gray-300 shadow-sm text-sm focus:border-blue-500 focus:ring-blue-500"

        / Date range
        div
          span.block.text-sm.font-medium.text-gray-700.mb-1 Letter Date
          .flex.items-center.gap-2
            = f.date_field :date_from, value: params[:date_from],
                class: "w-full rounded-md border-gray-300 shadow-sm text-sm focus:border-blue-500 focus:ring-blue-500"
            span.text-gray-400.text-xs to
            = f.date_field :date_to, value: params[:date_to],
                class: "w-full rounded-md border-gray-300 shadow-sm text-sm focus:border-blue-500 focus:ring-blue-500"

        = f.submit "Apply Filters", class: "w-full rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700 cursor-pointer"

        - if @filters_active
          = link_to "Clear filters", complete_response_letters_path, class: "block text-center text-sm text-gray-500 hover:text-gray-700 mt-1"

    / — Results —
    .flex-1.min-w-0
      .flex.items-center.justify-between.mb-4
        p.text-sm.text-gray-500
          - if @pagy.count > 0
            | Showing #{@pagy.from}–#{@pagy.to} of #{@pagy.count} #{"letter".pluralize(@pagy.count)}
          - else
            | No results

      - if @letters.any?
        .bg-white.rounded-lg.border.border-gray-200.overflow-hidden
          table.min-w-full.divide-y.divide-gray-200
            thead.bg-gray-50
              tr
                th.px-4.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Date
                th.px-4.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Application #(s)
                th.px-4.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Company
                th.px-4.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Center
                th.px-4.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Approver
            tbody.divide-y.divide-gray-100
              - @letters.each do |letter|
                tr.hover:bg-gray-50
                  td.px-4.py-3.text-sm.text-gray-600.whitespace-nowrap
                    = link_to complete_response_letter_path(letter), class: "block" do
                      = letter.letter_date&.strftime("%-m/%-d/%Y")
                  td.px-4.py-3.text-sm
                    = link_to complete_response_letter_path(letter), class: "block space-y-0.5" do
                      - letter.application_numbers.each do |num|
                        span.block.font-mono.text-xs.text-blue-700 = num
                  td.px-4.py-3.text-sm.text-gray-900
                    = link_to letter.company_name, complete_response_letter_path(letter), class: "hover:underline"
                  td.px-4.py-3.text-sm.text-gray-600
                    = link_to complete_response_letter_path(letter), class: "block" do
                      = letter.approver_center
                  td.px-4.py-3.text-sm.text-gray-600
                    = link_to complete_response_letter_path(letter), class: "block" do
                      = letter.approver_name

                - if @headlines&.key?(letter.id)
                  tr.bg-yellow-50
                    td colspan="5"
                      p.px-4.py-2.text-sm.text-gray-700.italic = raw @headlines[letter.id]

        .mt-4== @pagy.series_nav

      - else
        .bg-white.rounded-lg.border.border-gray-200.p-12.text-center
          p.text-gray-500.font-medium No letters found
          p.text-sm.text-gray-400.mt-1 Try broadening your search or clearing the filters
