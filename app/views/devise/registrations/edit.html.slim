.max-w-lg.mx-auto
  h1.text-xl.font-semibold.text-gray-900.mb-6 Account Settings

  .bg-white.rounded-lg.border.border-gray-200.px-6.py-8.shadow-sm
    = form_for resource, as: resource_name, url: registration_path(resource_name), html: { method: :put } do |f|
      = render "devise/shared/error_messages", resource: resource

      .space-y-5
        div
          = f.label :email, class: "block text-sm font-medium text-gray-700 mb-1"
          = f.email_field :email, autofocus: true, autocomplete: "email",
              class: "w-full rounded-md border-gray-300 shadow-sm text-sm focus:border-blue-500 focus:ring-blue-500"

        hr.border-gray-100

        div
          = f.label :password, "New password", class: "block text-sm font-medium text-gray-700 mb-1"
          p.text-xs.text-gray-400.mb-1 Leave blank to keep current password
          = f.password_field :password, autocomplete: "new-password",
              class: "w-full rounded-md border-gray-300 shadow-sm text-sm focus:border-blue-500 focus:ring-blue-500"

        div
          = f.label :password_confirmation, "Confirm new password", class: "block text-sm font-medium text-gray-700 mb-1"
          = f.password_field :password_confirmation, autocomplete: "new-password",
              class: "w-full rounded-md border-gray-300 shadow-sm text-sm focus:border-blue-500 focus:ring-blue-500"

        div
          = f.label :current_password, class: "block text-sm font-medium text-gray-700 mb-1"
          p.text-xs.text-gray-400.mb-1 Required to confirm any changes
          = f.password_field :current_password, autocomplete: "current-password",
              class: "w-full rounded-md border-gray-300 shadow-sm text-sm focus:border-blue-500 focus:ring-blue-500"

        = f.submit "Save changes", class: "w-full rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700 cursor-pointer"

  .mt-6.bg-white.rounded-lg.border.border-red-100.px-6.py-5
    h2.text-sm.font-medium.text-red-700.mb-1 Delete account
    p.text-xs.text-gray-500.mb-3 This is permanent and cannot be undone.
    = button_to "Delete my account", registration_path(resource_name), method: :delete,
        data: { turbo_confirm: "Are you sure you want to delete your account? This cannot be undone." },
        class: "rounded-md border border-red-300 px-4 py-2 text-sm font-medium text-red-600 hover:bg-red-50 cursor-pointer"
