.min-h-full.flex.flex-col.justify-center.-mt-8
  .sm:mx-auto.sm:w-full.sm:max-w-md
    .text-center.mb-8
      h1.text-2xl.font-bold.text-gray-900 Reset your password
      p.mt-2.text-sm.text-gray-600 Enter your email and we'll send you a reset link

    .bg-white.rounded-lg.border.border-gray-200.px-6.py-8.shadow-sm
      = form_for resource, as: resource_name, url: password_path(resource_name), html: { method: :post } do |f|
        = render "devise/shared/error_messages", resource: resource

        .space-y-5
          div
            = f.label :email, class: "block text-sm font-medium text-gray-700 mb-1"
            = f.email_field :email, autofocus: true, autocomplete: "email",
                class: "w-full rounded-md border-gray-300 shadow-sm text-sm focus:border-blue-500 focus:ring-blue-500"

          = f.submit "Send reset instructions", class: "w-full rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700 cursor-pointer"

      = render "devise/shared/links"
