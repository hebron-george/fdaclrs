.min-h-full.flex.flex-col.justify-center.-mt-8
  .sm:mx-auto.sm:w-full.sm:max-w-md
    .text-center.mb-8
      h1.text-2xl.font-bold.text-gray-900 Choose a new password

    .bg-white.rounded-lg.border.border-gray-200.px-6.py-8.shadow-sm
      = form_for resource, as: resource_name, url: password_path(resource_name), html: { method: :put } do |f|
        = render "devise/shared/error_messages", resource: resource
        = f.hidden_field :reset_password_token

        .space-y-5
          div
            .flex.items-center.justify-between.mb-1
              = f.label :password, "New password", class: "block text-sm font-medium text-gray-700"
              - if @minimum_password_length
                span.text-xs.text-gray-400 = "#{@minimum_password_length}+ characters"
            = f.password_field :password, autofocus: true, autocomplete: "new-password",
                class: "w-full rounded-md border-gray-300 shadow-sm text-sm focus:border-blue-500 focus:ring-blue-500"

          div
            = f.label :password_confirmation, "Confirm new password", class: "block text-sm font-medium text-gray-700 mb-1"
            = f.password_field :password_confirmation, autocomplete: "new-password",
                class: "w-full rounded-md border-gray-300 shadow-sm text-sm focus:border-blue-500 focus:ring-blue-500"

          = f.submit "Update password", class: "w-full rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700 cursor-pointer"

      = render "devise/shared/links"
