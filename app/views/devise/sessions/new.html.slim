.min-h-full.flex.flex-col.justify-center.-mt-8
  .sm:mx-auto.sm:w-full.sm:max-w-md
    .text-center.mb-8
      h1.text-2xl.font-bold.text-gray-900 Welcome back
      p.mt-2.text-sm.text-gray-600 Sign in to FDA CRL Explorer

    .bg-white.rounded-lg.border.border-gray-200.px-6.py-8.shadow-sm
      = form_for resource, as: resource_name, url: session_path(resource_name) do |f|
        .space-y-5
          div
            = f.label :email, class: "block text-sm font-medium text-gray-700 mb-1"
            = f.email_field :email, autofocus: true, autocomplete: "email",
                class: "w-full rounded-md border-gray-300 shadow-sm text-sm focus:border-blue-500 focus:ring-blue-500"

          div
            .flex.items-center.justify-between.mb-1
              = f.label :password, class: "block text-sm font-medium text-gray-700"
              - if devise_mapping.recoverable?
                = link_to "Forgot password?", new_password_path(resource_name), class: "text-xs text-blue-600 hover:text-blue-500"
            = f.password_field :password, autocomplete: "current-password",
                class: "w-full rounded-md border-gray-300 shadow-sm text-sm focus:border-blue-500 focus:ring-blue-500"

          - if devise_mapping.rememberable?
            .flex.items-center.gap-2
              = f.check_box :remember_me, class: "rounded border-gray-300 text-blue-600 focus:ring-blue-500"
              = f.label :remember_me, class: "text-sm text-gray-600"

          = f.submit "Sign in", class: "w-full rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700 cursor-pointer"

      = render "devise/shared/links"
