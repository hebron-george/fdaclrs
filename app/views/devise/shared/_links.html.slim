.mt-6.space-y-2.text-center
  - if controller_name != "sessions"
    p.text-sm.text-gray-600
      = link_to "Sign in to your account", new_session_path(resource_name), class: "font-medium text-blue-600 hover:text-blue-500"

  - if devise_mapping.registerable? && controller_name != "registrations"
    p.text-sm.text-gray-600
      | Don't have an account?
      = " "
      = link_to "Sign up", new_registration_path(resource_name), class: "font-medium text-blue-600 hover:text-blue-500"

  - if devise_mapping.recoverable? && controller_name != "passwords" && controller_name != "registrations"
    p.text-sm.text-gray-600
      = link_to "Forgot your password?", new_password_path(resource_name), class: "font-medium text-blue-600 hover:text-blue-500"

  - if devise_mapping.confirmable? && controller_name != "confirmations"
    p.text-sm.text-gray-600
      = link_to "Didn't receive confirmation instructions?", new_confirmation_path(resource_name), class: "font-medium text-blue-600 hover:text-blue-500"

  - if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != "unlocks"
    p.text-sm.text-gray-600
      = link_to "Didn't receive unlock instructions?", new_unlock_path(resource_name), class: "font-medium text-blue-600 hover:text-blue-500"
