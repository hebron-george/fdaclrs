- letter = @letter
- fields = LetterCorrection::CORRECTABLE_FIELDS

.mb-6
  = link_to "← All letters", admin_complete_response_letters_path, class: "text-sm text-blue-600 hover:underline"

.flex.flex-wrap.items-start.justify-between.gap-3.mb-6
  div
    h1.text-xl.font-semibold.text-gray-900 = letter.company_name.presence || "Letter ##{letter.id}"
    p.mt-1.text-sm.text-gray-500
      | #{letter.letter_date&.strftime("%-m/%-d/%Y") || "No date"} · #{letter.application_numbers.join(", ").presence || "No application #"}
  = link_to "View public page →", complete_response_letter_path(letter),
      target: "_blank", rel: "noopener noreferrer",
      class: "text-sm text-blue-600 hover:underline flex-shrink-0"

= form_with url: admin_complete_response_letter_path(letter), method: :patch do |f|
  .space-y-6
    - fields.each do |field_name, field_type|
      - history = @corrections_by_field[field_name] || []
      - latest  = history.last
      - first   = history.first
      - current_raw = letter[field_name]

      .bg-white.rounded-lg.border.border-gray-200.p-5.mt-4
        .flex.flex-col.sm:flex-row.sm:gap-8
          / — Input column —
          .flex-1
            label.block.text-sm.font-medium.text-gray-700.mb-1 for=field_name
              = field_name.humanize
              - if latest
                span.ml-2.inline-flex.items-center.rounded-full.px-1.5.py-0.5.text-xs.font-medium.bg-amber-100.text-amber-700.border.border-amber-200 corrected

            - if field_type == :date
              input.w-full.rounded-md.border-gray-300.shadow-sm.text-sm.focus:border-blue-500.focus:ring-blue-500{
                type="date"
                id=field_name
                name="corrections[#{field_name}]"
                value="#{current_raw&.iso8601}"
              }

            - elsif field_type == :string_array
              - display_val = Array(current_raw).compact.join(", ")
              input.w-full.rounded-md.border-gray-300.shadow-sm.text-sm.font-mono.focus:border-blue-500.focus:ring-blue-500{
                type="text"
                id=field_name
                name="corrections[#{field_name}]"
                placeholder="Comma-separated values"
                value="#{display_val}"
              }
            - else
              input.w-full.rounded-md.border-gray-300.shadow-sm.text-sm.focus:border-blue-500.focus:ring-blue-500{
                type="text"
                id=field_name
                name="corrections[#{field_name}]"
                value="#{current_raw}"
              }
            .mt-2
              label.block.text-xs.text-gray-500.mb-1 Note (optional — why was this corrected?)
              input.w-full.rounded-md.border-gray-300.shadow-sm.text-xs.focus:border-blue-500.focus:ring-blue-500{
                type="text"
                name="notes[#{field_name}]"
                placeholder="e.g. Date found on page 1 of the PDF"
              }

          / — History column —
          .mt-4.sm:mt-0.sm:w-64.flex-shrink-0
            - if history.any?
              p.text-xs.font-medium.text-gray-500.uppercase.tracking-wide.mb-2 Correction history
              ul.space-y-2
                - history.reverse.first(3).each do |log|
                  li.text-xs.text-gray-600
                    span.font-medium = log.user.email
                    |  · #{log.created_at.in_time_zone("America/New_York").strftime("%-m/%-d/%Y %l:%M %p ET")}
                    - if log.note.present?
                      p.text-gray-400.italic = log.note
              .mt-2.pt-2.border-t.border-gray-100
                p.text-xs.text-gray-400
                  | API original:
                  = " "
                  span.font-mono = first.original_value.presence || "(not provided)"
            - else
              p.text-xs.text-gray-400.italic No corrections yet — current value is from the API.

  .mt-6.flex.items-center.gap-3
    = f.submit "Save corrections", class: "rounded-md bg-blue-600 px-5 py-2 text-sm font-semibold text-white hover:bg-blue-700 cursor-pointer"
    = link_to "Cancel", admin_complete_response_letters_path, class: "text-sm text-gray-500 hover:text-gray-700"
