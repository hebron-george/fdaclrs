doctype html
html
  head
    meta name="viewport" content="width=device-width, initial-scale=1"
    title FDA Complete Response Letters
    = csrf_meta_tags
    = csp_meta_tag
    = stylesheet_link_tag "application", "data-turbo-track": "reload"
    = stylesheet_link_tag "tailwind", "data-turbo-track": "reload"
    = javascript_importmap_tags
  body.bg-gray-50.min-h-screen.flex.flex-col
    header.bg-white.border-b.border-gray-200
      .max-w-7xl.mx-auto.px-4.sm:px-6.lg:px-8
        .flex.items-center.justify-between.h-14.sm:h-16
          / Brand
          = link_to root_path, class: "flex items-center gap-2 flex-shrink-0" do
            span.text-base.sm:text-lg.font-semibold.text-gray-900 FDA CRL Explorer

          / Nav — collapses gracefully on mobile
          nav.flex.items-center.gap-3.sm:gap-4.min-w-0
            = link_to "Browse", complete_response_letters_path,
                class: "text-sm text-gray-600 hover:text-gray-900 flex-shrink-0"
            - if user_signed_in? && current_user.admin?
              = link_to "Admin", admin_complete_response_letters_path,
                  class: "hidden sm:block text-sm font-medium text-amber-600 hover:text-amber-800 flex-shrink-0"
            - if user_signed_in?
              = link_to "Subscriptions", subscriptions_path,
                  class: "hidden sm:block text-sm text-gray-600 hover:text-gray-900 flex-shrink-0"
              .hidden.sm:block.h-4.w-px.bg-gray-200
              = link_to edit_user_registration_path,
                  class: "hidden sm:block text-sm text-gray-600 hover:text-gray-900 truncate max-w-40",
                  title: current_user.email do
                = current_user.email
              = button_to "Sign out", destroy_user_session_path, method: :delete,
                  class: "text-sm text-gray-500 hover:text-gray-700 cursor-pointer bg-transparent border-0 p-0 flex-shrink-0"
            - else
              = link_to "Sign in", new_user_session_path,
                  class: "text-sm text-gray-600 hover:text-gray-900 flex-shrink-0"

    main.flex-1
      .max-w-7xl.mx-auto.px-4.sm:px-6.lg:px-8.py-6.sm:py-8
        - if notice
          .mb-4.rounded-md.bg-green-50.border.border-green-200.px-4.py-3.text-sm.text-green-800 = notice
        - if alert
          .mb-4.rounded-md.bg-yellow-50.border.border-yellow-200.px-4.py-3.text-sm.text-yellow-800 = alert
        = yield

    footer.border-t.border-gray-200.bg-white
      .max-w-7xl.mx-auto.px-4.sm:px-6.lg:px-8.py-4
        - last_sync = SystemSetting.get("last_crl_sync_at")
        p.text-xs.text-gray-400
          - if last_sync
            | Data last updated: #{Time.parse(last_sync).in_time_zone("America/New_York").strftime("%B %-d, %Y at %l:%M %p ET")}
          - else
            | Data not yet synced
